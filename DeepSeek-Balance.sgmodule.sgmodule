# Surge DeepSeek 余额查询模块（iCloud 纯本地版）
# 作者：Minis 助手
# 功能：面板快捷方式查询余额 + Key 持久化存储 + 人民币不足1元提醒


[Script]
# 使用 iCloud 路径（推荐）
deepseek-balance = type=http-request,pattern=^http://surge\.local/deepseek-balance$,requires-body=false,script-path=https://raw.githubusercontent.com/lwg3517/Surge/refs/heads/main/Ds.js
# 如果你的 Surge 文件夹路径不同，可改成实际相对路径（如 Surge/Ds.js）

[Panel]
deepseek-balance = script-name=deepseek-balance,title=DeepSeek 余额,icon=dollarsign.circle,icon-color=#34C759